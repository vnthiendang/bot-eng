# Google Gemini API Key (https://aistudio.google.com/apikey)
GEMINI_API_KEY=your_gemini_api_key_here

# Express Web Server Port
PORT=3000

# Discord Bot Configuration (Tùy chọn - dùng khi chạy chế độ Discord Bot 24/7)
DISCORD_BOT_TOKEN=your_discord_bot_token_here
DISCORD_CLIENT_ID=your_discord_application_client_id_here
DISCORD_CHANNEL_ID=your_target_channel_id_for_daily_reminders
DISCORD_GUILD_ID=

# Discord Webhook URL (Tùy chọn - dùng để gửi bài tập trực tiếp từ Web UI / Vercel)
DISCORD_WEBHOOK_URL=

# Lịch nhắc tự động (Cron format, mặc định múi giờ Asia/Ho_Chi_Minh)
MORNING_CRON=0 8 * * *
EVENING_CRON=0 21 * * *
TIMEZONE=Asia/Ho_Chi_Minh
